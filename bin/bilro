#!/usr/bin/env node
import { join, dirname } from "node:path";
import { homedir } from "node:os";
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";

const HERE = dirname(fileURLToPath(import.meta.url));
import { execFileSync } from "node:child_process";
import { loadMemories, audit } from "../lib/memory.js";
import { ruleset, readLevel, writeLevel, LEVELS } from "../lib/style.js";
import { run as sandboxRun, open as openIndex, search as searchIndex } from "../lib/sandbox.js";
import { filter, rules as filterRules } from "../lib/filters.js";
import { sessions, summarize, prune as prunePast } from "../lib/ledger.js";
import { open as openLearn, observe, denoise, similarity, novelty, rankByInformation } from "../lib/learn.js";
import {
  weighAlwaysOn,
  weighMemory,
  weighAgents,
  weighMcp,
  weighPlugins,
} from "../lib/weigh.js";

const BOLD = "\x1b[1m";
const DIM = "\x1b[2m";
const WARN = "\x1b[33m";
const OFF = "\x1b[0m";

function bar(value, max, width = 24) {
  const filled = max > 0 ? Math.round((value / max) * width) : 0;
  return "█".repeat(filled) + "░".repeat(Math.max(0, width - filled));
}

function agentDirs(cwd) {
  return [join(homedir(), ".claude", "agents"), join(cwd, ".claude", "agents")];
}

function bill(cwd) {
  const always = weighAlwaysOn();
  const slug = "-" + cwd.replace(/^\//, "").replace(/\//g, "-");
  const all = weighMemory();
  const memory = all.filter((m) => m.project === slug);
  const foreign = all.filter((m) => m.project !== slug);
  const agents = weighAgents(agentDirs(cwd));
  const mcp = weighMcp();
  const plugins = weighPlugins();

  const catalogue = agents.reduce((n, a) => n + a.catalogueTokens, 0);
  const alwaysTotal = always.reduce((n, f) => n + f.tokens, 0);
  const memoryTotal = memory.reduce((n, m) => n + m.tokens, 0);
  const total = catalogue + alwaysTotal + memoryTotal;

  const rows = [
    ...always.map((f) => [f.name, f.tokens]),
    ...memory.map((m) => [`MEMORY.md ${DIM}(${m.entries} entradas)${OFF}`, m.tokens]),
    [`catálogo de ${agents.length} agentes`, catalogue],
  ].sort((a, b) => b[1] - a[1]);

  const max = rows.length ? rows[0][1] : 1;

  console.log(`\n  ${BOLD}o que você paga antes de pedir qualquer coisa${OFF}\n`);
  for (const [label, tokens] of rows) {
    console.log(`  ${String(tokens).padStart(6)} ${DIM}tok${OFF}  ${bar(tokens, max)}  ${label}`);
  }
  console.log(`  ${"─".repeat(58)}`);
  console.log(`  ${BOLD}${String(total).padStart(6)} tok${OFF}  por request, use ou não\n`);

  const inherits = agents.filter((a) => a.inheritsEverything);
  const noCtx = agents.filter((a) => !a.hasContextMode);

  if (inherits.length) {
    console.log(`  ${WARN}⚠${OFF}  ${inherits.length} agentes sem \`tools:\` herdam o catálogo inteiro`);
    console.log(`     ${DIM}${inherits.slice(0, 6).map((a) => a.name).join(", ")}${OFF}`);
  }
  if (noCtx.length) {
    console.log(`  ${WARN}⚠${OFF}  ${noCtx.length} agentes sem ctx_* — não conseguem usar context-mode`);
  }
  if (mcp.length) {
    console.log(`  ${DIM}   ${mcp.length} servidores MCP: ${mcp.map((m) => m.name).join(", ")}${OFF}`);
  }
  if (plugins.length) {
    console.log(`  ${DIM}   ${plugins.length} plugins instalados${OFF}`);
  }
  if (foreign.length) {
    const heaviest = foreign.sort((a, b) => b.tokens - a.tokens)[0];
    console.log(
      `  ${DIM}   ${foreign.length} outros projetos têm memória; o maior pesa ${heaviest.tokens} tok${OFF}`,
    );
  }
  console.log();
}

function styleConflict() {
  if (readLevel() === "off") return null;
  const plugins = weighPlugins();
  const rival = plugins.find((p) => /caveman/i.test(p));
  return rival ? rival.split("@")[0] : null;
}

function doctor() {
  const agents = weighAgents(agentDirs(process.cwd()));
  const problems = [];
  for (const a of agents) {
    if (a.inheritsEverything) problems.push([a.name, "sem tools: — herda tudo"]);
    else if (!a.hasContextMode) problems.push([a.name, "sem ctx_* — context-mode não alcança"]);
  }
  const rival = styleConflict();
  if (rival) {
    console.log(`\n  ${WARN}⚠${OFF}  bilro style esta ligado e ${rival} tambem injeta estilo.`);
    console.log(`     ${DIM}duas regras competindo pioram a saida — desligue uma${OFF}`);
  }
  if (!problems.length) {
    if (!rival) console.log("\n  tudo no lugar.\n");
    else console.log();
    return;
  }
  console.log(`\n  ${problems.length} agentes com problema:\n`);
  for (const [name, why] of problems) console.log(`  ${name.padEnd(28)} ${DIM}${why}${OFF}`);
  console.log();
}

function memoryDir(cwd) {
  const slug = "-" + cwd.replace(/^\//, "").replace(/\//g, "-");
  return join(homedir(), ".claude", "projects", slug, "memory");
}

function verify(cwd) {
  const dir = memoryDir(cwd);
  const memories = loadMemories(dir);
  if (!memories.length) {
    console.log(`\n  este projeto nao tem memoria em ${DIM}${dir}${OFF}\n`);
    return;
  }
  const rows = audit(memories);
  if (!rows.length) {
    console.log(`\n  ${memories.length} memorias, nenhuma afirma fato que envelhece.\n`);
    return;
  }
  const checked = [];
  const suspect = rows.filter((r) => r.status === "suspeita");
  const asserts = rows.filter((r) => r.status === "afirma");

  for (const row of rows.filter((r) => r.status === "verificavel")) {
    let output = "";
    let ok = false;
    try {
      output = execFileSync("/bin/sh", ["-c", row.memory.verify], {
        encoding: "utf8",
        timeout: 30000,
      });
      ok = row.memory.expect ? output.includes(row.memory.expect) : true;
    } catch (e) {
      output = String(e.message || e).slice(0, 120);
    }
    checked.push({ row, ok, output: output.trim().split("\n").slice(-1)[0] });
  }

  console.log();
  for (const c of checked) {
    const mark = c.ok ? "\x1b[32m✓\x1b[0m" : "\x1b[31m✗\x1b[0m";
    console.log(`  ${mark} ${c.row.memory.name}`);
    if (!c.ok) console.log(`      esperava ${JSON.stringify(c.row.memory.expect)}, veio ${DIM}${c.output}${OFF}`);
  }
  if (suspect.length) {
    console.log(`\n  ${WARN}${suspect.length} memorias afirmam fato que envelhece e nao sabem se verificar${OFF}`);
    for (const s of suspect.slice(0, 8)) {
      const kinds = s.claims.map((c) => `${c.kind} ${c.samples[0]}`).join(", ");
      console.log(`    ${s.memory.name.padEnd(38)} ${DIM}${s.age}d  ${kinds}${OFF}`);
    }
  }
  console.log(`\n  ${DIM}${checked.length} verificadas, ${suspect.length} suspeitas, ${asserts.length} recentes${OFF}\n`);
}

function sessionOpen(cwd) {
  const always = weighAlwaysOn();
  const slug = "-" + cwd.replace(/^\//, "").replace(/\//g, "-");
  const memory = weighMemory().filter((m) => m.project === slug);
  const agents = weighAgents(agentDirs(cwd));
  const total =
    always.reduce((n, f) => n + f.tokens, 0) +
    memory.reduce((n, m) => n + m.tokens, 0) +
    agents.reduce((n, a) => n + a.catalogueTokens, 0);
  const inherits = agents.filter((a) => a.inheritsEverything).length;
  const parts = [];
  const rules = ruleset();
  if (rules) parts.push(rules);
  parts.push(`bilro: ${total} tok de custo fixo por request neste projeto.`);
  if (inherits) parts.push(`${inherits} agentes sem tools: herdam o catalogo inteiro quando despachados.`);
  parts.push("Antes de despachar agente, pergunte se da pra medir com ctx_execute.");
  process.stdout.write(parts.join(" "));
}

function hook(kind) {
  if (kind === "session") return sessionOpen(process.cwd());
  const child = join(HERE, "..", "hooks", "preflight.js");
  const raw = readFileSync(0, "utf8");
  execFileSync(process.execPath, [child], { input: raw, stdio: ["pipe", "inherit", "ignore"] });
}

function runCmd(argv) {
  const qi = argv.indexOf("--find");
  const command = (qi === -1 ? argv : argv.slice(0, qi)).join(" ");
  const queries = qi === -1 ? [] : argv.slice(qi + 1);
  if (!command) return console.log("\n  uso: bilro run <comando> [--find <termo>...]\n");
  const r = sandboxRun({ command, queries });
  console.log();
  console.log(
    `  ${r.failed ? "\x1b[31mfalhou\x1b[0m" : "ok"}  ${r.chunks} trechos indexados, ` +
      `${BOLD}${r.withheldTokens} tok${OFF} ficaram fora do contexto`,
  );
  for (const h of r.hits) {
    console.log(`\n  ${DIM}${h.q}${OFF}`);
    console.log(
      h.body
        .split("\n")
        .slice(0, 8)
        .map((l) => `    ${l}`)
        .join("\n"),
    );
  }
  console.log(`\n  ${DIM}bilro find "<termo>" recupera o resto${OFF}\n`);
}

function sessionReport() {
  const all = sessions();
  if (!all.length) return console.log("\n  nenhuma sessao registrada ainda.\n");
  console.log(`\n  ${BOLD}ultimas sessoes${OFF}\n`);
  for (const s of all.slice(0, 8)) {
    const t = summarize(s.id);
    if (!t.dispatches && !t.saved) continue;
    const when = new Date(s.mtime).toISOString().slice(5, 16).replace("T", " ");
    const repeat = t.repeats ? ` ${WARN}${t.repeats} repetidos${OFF}` : "";
    console.log(
      `  ${DIM}${when}${OFF}  ${String(t.dispatches).padStart(3)} agentes  ` +
        `${BOLD}${String(Math.round(t.dispatchCost / 1000)).padStart(4)}k${OFF} de custo fixo${repeat}`,
    );
  }
  const total = all.reduce((n, s) => n + summarize(s.id).dispatchCost, 0);
  const rep = all.reduce((n, s) => n + summarize(s.id).repeats, 0);
  console.log(`  ${"─".repeat(56)}`);
  console.log(`  ${BOLD}${Math.round(total / 1000)}k${OFF} em custo fixo de agente, ${rep} despachos repetidos\n`);
}

function filterCmd(argv) {
  const command = argv.join(" ");
  if (!command) return console.log(`\n  uso: bilro filter <comando>\n  regras: ${filterRules.join(", ")}\n`);
  let raw = "";
  try {
    raw = execFileSync("/bin/sh", ["-c", command], { encoding: "utf8", maxBuffer: 64 * 1024 * 1024 });
  } catch (e) {
    raw = String(e.stdout || "") + String(e.stderr || e.message || "");
  }
  const db = openLearn();
  const seen = observe(db, command, raw);
  if (seen.unchanged) {
    db.close();
    console.error(
      `${DIM}bilro: identico a execucao anterior (${seen.runs}a vez), ${Math.round(raw.length / 4)} tok nao repetidos${OFF}`,
    );
    return;
  }
  const near = seen.previous ? similarity(seen.previous, raw) : 0;
  let learned;
  let mode = null;
  if (near >= 0.9 && seen.previous) {
    const novas = novelty(seen.previous, raw);
    learned = { text: novas.join("\n"), learned: true, dropped: raw.split("\n").length - novas.length };
    mode = `${Math.round(near * 100)}% igual a anterior, so a diferenca`;
  } else {
    learned = denoise(db, command, raw);
  }
  const ranked = rankByInformation(db, command, learned.text);
  if (ranked.ranked) mode = `${ranked.kept} linhas mais informativas de ${ranked.from}`;
  learned = { ...learned, text: ranked.text };
  db.close();

  const r = filter(command, learned.text);
  process.stdout.write(r.text + "\n");
  const saved = raw.length - r.after;
  const pct = raw.length ? Math.round((saved / raw.length) * 100) : 0;
  const how = [r.rule && `regra ${r.rule}`, mode || (learned.learned && `${learned.dropped} linhas sem informacao`)]
    .filter(Boolean)
    .join(" + ");
  console.error(
    `${DIM}bilro: ${Math.round(saved / 4)} tok cortados, ${pct}%${how ? ` (${how})` : ""}${OFF}`,
  );
}

function findCmd(argv) {
  const q = argv.join(" ");
  if (!q) return console.log("\n  uso: bilro find <termo>\n");
  const db = openIndex();
  const rows = searchIndex(db, q, 5);
  db.close();
  if (!rows.length) return console.log(`\n  nada indexado bate com ${JSON.stringify(q)}\n`);
  console.log();
  for (const r of rows) {
    console.log(`  ${DIM}${r.source}${OFF}`);
    console.log(
      r.body
        .split("\n")
        .slice(0, 10)
        .map((l) => `    ${l}`)
        .join("\n") + "\n",
    );
  }
}

const [, , cmd = "bill"] = process.argv;
if (cmd === "bill") bill(process.cwd());
else if (cmd === "doctor") doctor();
else if (cmd === "verify") verify(process.cwd());
else if (cmd === "hook") hook(process.argv[3]);
else if (cmd === "run") runCmd(process.argv.slice(3));
else if (cmd === "find") findCmd(process.argv.slice(3));
else if (cmd === "filter") filterCmd(process.argv.slice(3));
else if (cmd === "sessions") sessionReport();
else if (cmd === "prune") console.log(`\n  ${prunePast()} sessoes antigas removidas\n`);
else if (cmd === "style") {
  const arg = process.argv[3];
  if (!arg) console.log(`\n  nivel atual: ${readLevel()}   ${DIM}(${LEVELS.join(" | ")})${OFF}\n`);
  else {
    try {
      console.log(`\n  estilo: ${writeLevel(arg)}\n`);
    } catch (e) {
      console.log(`\n  ${e.message}\n`);
      process.exit(1);
    }
  }
}
else {
  console.log(`
  bilro — o peso vazio do seu contexto

    bilro bill      o que você paga por request, ranqueado
    bilro doctor    agentes mal configurados
    bilro verify    memoria que afirma fato e nao sabe se conferir
    bilro hook <k>  ponto de entrada dos hooks (session | task)
    bilro style     nivel de concisao da resposta (off | lean | terse)
    bilro run <cmd> roda no sandbox, indexa a saida, devolve so o tamanho
    bilro find <q>  recupera trecho do que ja foi indexado
    bilro filter <c> roda e corta o ruido conhecido da saida
    bilro sessions  custo de agente por sessao, e quantos repetiram assunto
    bilro prune     descarta registro de sessao com mais de 14 dias
`);
}
